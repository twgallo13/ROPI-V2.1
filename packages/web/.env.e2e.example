# E2E Test User Credentials
# 
# This file is for LOCAL E2E test runs only.
# In CI/GitHub Actions, these values come from repository secrets.
# 
# Create these users in Firebase Auth (staging project: ropi-bccee)
# and set the actual passwords here for local testing.

# Admin user (requires custom claim: role: admin)
VITE_E2E_ADMIN_EMAIL=theo@shiekh.com
VITE_E2E_ADMIN_PASSWORD=changeme-admin

# Regular verified user
VITE_E2E_USER_EMAIL=user@shiekh.com
VITE_E2E_USER_PASSWORD=changeme-user

# Unverified user (create account but do NOT verify email)
VITE_E2E_UNVERIFIED_EMAIL=unverified@shiekh.com
VITE_E2E_UNVERIFIED_PASSWORD=changeme-unverified
