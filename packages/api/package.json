{
  "name": "@ropi-aoss/api",
  "version": "0.0.0",
  "description": "Firebase Cloud Functions for ROPI AOSS API",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "node esbuild.config.js",
    "postbuild": "mkdir -p dist/config && cp -f ../sdk/config/attributeRegistry.json dist/config/attributeRegistry.json || true",
    "build:types": "tsc --emitDeclarationOnly || true",
    "lint": "eslint src --ext .ts || true",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:export-gate": "vitest run --reporter=verbose src/lib/export/ src/controllers/ExportController.test.ts",
    "clean": "rm -rf dist",
    "serve": "firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "sync:attributes": "node dist/tasks/syncAttributeRegistry.js",
    "migrate:products-to-attributes": "node dist/tasks/migrateProductsToAttributes.js",
    "normalize:attributes": "node dist/tasks/normalizeProductAttributeValues.js"
  },
  "dependencies": {
    "@google-cloud/logging": "^11.0.0",
    "@google-cloud/storage": "^7.18.0",
    "busboy": "^1.6.0",
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^6.1.1",
    "handlebars": "^4.7.8",
    "papaparse": "^5.4.1",
    "uuid": "^9.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.0",
    "@types/cors": "^2.8.0",
    "@types/express": "^4.17.0",
    "@types/node": "^18.0.0",
    "@types/papaparse": "^5.3.0",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^9.0.0",
    "esbuild": "^0.27.1",
    "supertest": "^7.1.4",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": "20"
  }
}
