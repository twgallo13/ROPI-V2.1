{
  "name": "@ropi-aoss/api",
  "version": "0.0.0",
  "description": "Firebase Cloud Functions for ROPI AOSS API",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "lint": "eslint src --ext .ts || true",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "serve": "firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions"
  },
  "dependencies": {
    "@ropi-aoss/sdk": "workspace:*",
    "busboy": "^1.6.0",
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^6.1.1",
    "papaparse": "^5.4.1",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.0",
    "@types/express": "^4.17.0",
    "@types/node": "^18.0.0",
    "@types/papaparse": "^5.3.0",
    "@types/uuid": "^9.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
