  "rootCauseAnalysis": {
    "summary": "The extractSelectedSites() function in completionDrivenExportReadiness.ts does NOT check attributes.website, only top-level websites/sites/website fields",
    "affectedFunction": "extractSelectedSites",
    "file": "packages/api/src/services/completionDrivenExportReadiness.ts",
    "lineNumber": 423,
    "currentBehavior": "Only checks: product.websites, product.sites, product.website (string)",
    "missingCheck": "Does NOT check product.attributes.website which is where CSV imports store site data",
    "evidence": [
      "8 products have attributes.website data that is NOT being read",
