{
  "name": "ropi-aoss",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "bootstrap": "pnpm -w install",
    "build": "pnpm -r --filter ./... build",
    "lint": "pnpm -r --filter ./... lint || eslint . --ext .ts,.tsx,.js,.jsx || true",
    "test": "pnpm -r --filter ./... test || echo \"No tests yet\"",
    "seed": "node scripts/seed.js",
    "api:sync:attributes": "pnpm --filter @ropi-aoss/api build && pnpm --filter @ropi-aoss/api sync:attributes",
    "api:migrate:products-to-attributes": "pnpm --filter @ropi-aoss/api build && pnpm --filter @ropi-aoss/api migrate:products-to-attributes",
    "api:normalize:attributes": "pnpm --filter @ropi-aoss/api build && pnpm --filter @ropi-aoss/api normalize:attributes"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@google-cloud/firestore": "^8.0.0",
    "eslint": "^8.0.0",
    "firebase": "^12.6.0",
    "firebase-admin": "^13.6.0",
    "playwright": "^1.57.0",
    "pnpm": "^8.0.0",
    "prettier": "^2.8.0",
    "puppeteer": "^24.34.0",
    "typescript": "^5.0.0",
    "yargs": "^18.0.0"
  },
  "dependencies": {
    "@notionhq/client": "^3.1.3"
  }
}
